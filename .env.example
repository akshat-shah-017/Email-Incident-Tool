# ==================================
# Email Incident Tool - Environment Variables
# ==================================
# Copy this file to .env and fill in your values

# ==================================
# Database Configuration
# ==================================
# DATABASE_URL="postgresql://postgres:password@localhost:5432/email_incidents?schema=public"

# For Docker setup, use:
DATABASE_URL="postgresql://postgres:password@db:5432/email_incidents?schema=public"

# ==================================
# AI Service API Keys
# ==================================
# OpenRouter API Key (Primary AI service)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="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"

# Google Gemini API Key (Fallback AI service)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="AIzaSyD5l-SypNTmVxDssN5-6JnmId2e8Qt39uU"

# AI Model Configuration
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# GEMINI_MODEL="gemini-2.0-flash-exp"

# ==================================
# Server Configuration
# ==================================
PORT=5000
NODE_ENV=development

# ==================================
# Frontend Configuration
# ==================================
VITE_API_URL=http://localhost:5000/api

# ==================================
# CORS Configuration
# ==================================
CORS_ORIGIN=http://localhost:3000

# ==================================
# File Upload Configuration
# ==================================
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# ==================================
# Logging Configuration
# ==================================
LOG_LEVEL=info
LOG_FORMAT=combined

# ==================================
# Rate Limiting
# ==================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
