{
    "name": "email-incident-backend",
    "version": "1.0.0",
    "description": "Backend API for Email Incident Logging & Summarization Tool",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "lint": "eslint src/**/*.ts",
        "lint:fix": "eslint src/**/*.ts --fix",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:prod": "prisma migrate deploy",
        "prisma:seed": "ts-node prisma/seed.ts",
        "prisma:studio": "prisma studio",
        "docker:build": "docker build -t email-incident-backend .",
        "docker:run": "docker run -p 5000:5000 email-incident-backend"
    },
    "dependencies": {
        "@prisma/client": "^5.7.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "eml-parser": "^1.0.6",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "morgan": "^1.10.0",
        "@kenjiuno/msgreader": "^1.27.0",
        "multer": "^1.4.5-lts.1",
        "uuid": "^9.0.1",
        "winston": "^3.11.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.10.5",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "prisma": "^5.7.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "email",
        "incident",
        "parsing",
        "ai",
        "summarization"
    ],
    "author": "",
    "license": "MIT"
}